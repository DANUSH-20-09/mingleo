# VibeConnect Environment Variables

# Server Port
PORT=5001

# Allowed Client Origin (for CORS)
CLIENT_ORIGIN=http://localhost:5173

# Optional: Supabase Integration for Persistent Moderation Logs and Auditing
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=

# Optional: Development Auto-Simulate (pairs solo user with interactive simulated partner after timeout)
DEV_AUTO_SIMULATE=false
